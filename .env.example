# Copy this file to .env.local for local development and fill in real
# values. .env.local is gitignored — never commit real secret keys.
#
# For the deployed site, set this in Netlify's dashboard instead:
# Site configuration -> Environment variables. Do not paste real
# secret keys into chat, commits, or any client-visible code — this
# key must only ever live server-side.

# Stripe secret key (server-only, starts with sk_test_ or sk_live_).
# Get it from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
